FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../blockMeshDict.cfg"

vertices
(
    (0      0      $z0)
    ($ct    0      $z0)
    ($ct    $ch    $z0)
    (0      $ch    $z0)

    (0      0       $z1)
    ($ct    0       $z1)
    ($ct    $ch     $z1)
    (0      $ch     $z1)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (10 45 1) simpleGrading (1 1 1)
);

defaultPatch
{
    name frontAndBack;
    type empty;
}

boundary
(
    cantilever
    {
        type            mappedWall;
        neighbourPatch  cantilever;
        neighbourRegion fluid;
        method          intersection;
        matchTolerance  0.1;
        faces
        (
            (3 7 6 2)
            (0 4 7 3)
            (2 6 5 1)
        );
    }

    fixed
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }
);

