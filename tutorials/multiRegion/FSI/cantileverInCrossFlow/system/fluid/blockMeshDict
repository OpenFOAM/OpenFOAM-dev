FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../blockMeshDict.cfg"

vertices
(
    ($il  0    $z0)
    (0    0    $z0)
    ($ct  0    $z0)
    ($ol  0    $z0)
    ($il  $ch  $z0)
    (0    $ch  $z0)
    ($ct  $ch  $z0)
    ($ol  $ch  $z0)
    ($il  $h   $z0)
    (0    $h   $z0)
    ($ct  $h   $z0)
    ($ol  $h   $z0)

    ($il  0     $z1)
    (0    0     $z1)
    ($ct  0     $z1)
    ($ol  0     $z1)
    ($il  $ch   $z1)
    (0    $ch   $z1)
    ($ct  $ch   $z1)
    ($ol  $ch   $z1)
    ($il  $h    $z1)
    (0    $h    $z1)
    ($ct  $h    $z1)
    ($ol  $h    $z1)
);

blocks
(
    hex (0 1 5 4 12 13 17 16)   (40  25 1)  simpleGrading   (0.1 0.25 1)
    hex (2 3 7 6 14 15 19 18)   (100 25 1)  simpleGrading   (10  0.25 1)
    hex (4 5 9 8 16 17 21 20)   (40  25 1)  simpleGrading   (0.1 2    1)
    hex (6 7 11 10 18 19 23 22) (100 25 1)  simpleGrading   (10  2    1)
    hex (5 6 10 9 17 18 22 21)  (5   25 1)  simpleGrading   (1   2    1)
);

defaultPatch
{
    name frontAndBack;
    type empty;
}

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 12 16 4)
            (4 16 20 8)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (3 7 19 15)
            (7 11 23 19)
        );
    )

    cantilever
    {
        type            mappedWall;
        neighbourPatch  cantilever;
        neighbourRegion cantilever;
        method          intersection;
        matchTolerance  0.1;
        faces
        (
            (1 13 17 5)
            (5 17 18 6)
            (6 18 14 2)
        );
    }

    top
    {
        type wall;
        faces
        (
            (8 20 21 9)
            (9 21 22 10)
            (10 22 23 11)
        );
    }

    bottom
    {
        type wall;
        faces
        (
            (0 1 13 12)
            (2 3 15 14)
        );
    }
);


