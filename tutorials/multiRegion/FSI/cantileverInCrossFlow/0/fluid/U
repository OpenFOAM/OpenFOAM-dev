FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [velocity];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            uniformFixedValue;

        uniformValue
        {
            type               scale;

            scale
            {
                type           linearRamp;

                start           0;
                duration        0.002;
            }

            value (3 0 0);
        }

        value           $internalField;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
    }

    cantilever
    {
        type            movingWallVelocity;
        value           $internalField;
    }

    top
    {
        type            noSlip;
    }

    bottom
    {
        type            noSlip;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

