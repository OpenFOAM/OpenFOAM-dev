FoamFile
{
    format      ascii;
    class       pointVectorField;
    location    "0.orig";
    object      pointDisplacement;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [length];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            uniformFixedValue;
        uniformValue    (0 0 0);
    }

    outlet
    {
        type            uniformFixedValue;
        uniformValue    (0 0 0);
    }

    cantilever
    {
        type            calculated;
        value           uniform (0 0 0);
    }

    top
    {
        type            fixedNormalSlip;
        n               (0 1 0);
    }

    bottom
    {
        type            uniformFixedValue;
        uniformValue    (0 0 0);
    }

    #includeEtc "caseDicts/setConstraintTypes"
}


